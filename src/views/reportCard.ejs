<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Progress Report - <%= student.name %></title>

<style>
@page {
    size: A4 portrait;
    margin: 5mm;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    width: 210mm;
    font-family: "Times New Roman", serif;
    background: #fff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}

.page-container {
    width: 200mm;
    min-height: 277mm;
    margin: 0 auto;
    padding: 10mm 8mm;
    border: 2px solid #000;
    position: relative;
    box-sizing: border-box;
    background: #fff;
    display: flex;
    flex-direction: column;
}

/* Logo Watermark */
.logo-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140mm;
    height: 140mm;
    opacity: 0.04;
    z-index: 1;
    pointer-events: none;
}

.logo-watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.content-layer {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
}

/* Main content */
.main-content {
    flex: 1;
}

/* Header Section */
.header-section {
    text-align: center;
    margin-bottom: 15px;
}

.school-logo {
    width: 25mm;
    height: 25mm;
    margin: 0 auto 5px;
}

.school-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.school-name {
    font-size: 14px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.arabic-text {
    font-size: 12px;
    font-weight: bold;
    margin-bottom: 5px;
    color: #333;
}

.report-title {
    font-size: 16px;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: underline;
    margin-bottom: 15px;
}

/* Student Info */
.student-info {
    margin-bottom: 15px;
    font-size: 11px;
}

.info-row {
    margin-bottom: 3px;
    font-weight: bold;
}

.info-label {
    display: inline-block;
    width: 85px;
}

.info-value {
    font-weight: normal;
}

/* Marks Table */
.marks-table {
    width: 100%;
    border-collapse: collapse;
    margin: 15px 0;
    font-size: 10px;
}

.marks-table th,
.marks-table td {
    border: 1.5px solid #000;
    padding: 6px 4px;
    text-align: center;
    vertical-align: middle;
}

.marks-table th {
    background: #f0f0f0;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 9px;
}

.marks-table td:first-child {
    text-align: left;
    font-weight: 600;
    padding-left: 8px;
}

/* Total Row */
.total-row {
    font-weight: 900;
    background: #f0f0f0;
}

.total-row td {
    font-weight: 900;
}

/* Attendance Section */
.attendance-section {
    margin: 15px 0;
    padding: 8px 10px;
    border: 1.5px solid #000;
    background: #fff;
}

.attendance-row {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 700;
}

/* Remarks Section */
.remarks-section {
    margin-top: 15px;
    font-size: 11px;
    font-weight: bold;
}

.remarks-label {
    display: inline-block;
    width: 60px;
}

.remarks-line {
    display: inline-block;
    width: 620px;
    border-bottom: 1px solid #000;
    margin-left: 5px;
}

/* Signature Section */
.signature-section {
    margin-top: 20px;
    display: flex;
    justify-content: space-between;
    gap: 20px;
}

.signature-item {
    flex: 1;
    text-align: center;
}

.signature-label {
    font-size: 10px;
    font-weight: 700;
    margin-bottom: 20px;
}

.signature-line {
    border-top: 1.5px solid #000;
    width: 100%;
    margin-top: 5px;
}

/* Instructions Section */
.instructions-section {
    margin-top: 15px;
    margin-bottom: 10px;
    font-size: 8px;
    color: #444;
    line-height: 1.5;
    border-top: 1px solid #ccc;
    padding-top: 10px;
}

.instructions-title {
    font-weight: 900;
    text-decoration: underline;
    margin-bottom: 5px;
    font-size: 9px;
}

.instructions-list {
    list-style-type: none;
    padding-left: 0;
}

.instructions-list li {
    margin-bottom: 2px;
}

/* Grade Legend */
.grade-legend {
    margin-top: 10px;
    padding: 6px 10px;
    border: 1.5px solid #000;
    background: #fff;
}

.legend-title {
    font-size: 9px;
    font-weight: 900;
    margin-bottom: 3px;
}

.legend-text {
    font-size: 8px;
    font-weight: 600;
    line-height: 1.4;
}

/* Bottom Info Row */
.bottom-info-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 10px;
    border-top: 1px solid #000;
    padding-top: 8px;
}

.grade-info {
    font-size: 8px;
    font-weight: bold;
    text-align: left;
}

.generated-info {
    font-size: 8px;
    color: #666;
    text-align: right;
}

/* Print optimization */
@media print {
    html, body {
        width: 210mm;
        margin: 0;
        padding: 0;
    }
    
    th {
        background: #f0f0f0 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    
    .total-row td {
        background: #f0f0f0 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    
    .page-container {
        border: 2px solid #000;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    
    .logo-watermark {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
}
</style>
</head>

<body>

<div class="page-container">
    
    <!-- Logo Watermark -->
    <div class="logo-watermark">
        <img src="<%= schoolLogo %>" alt="Watermark">
    </div>
    
    <div class="content-layer">
        
        <div class="main-content">
            
            <!-- Header -->
            <div class="header-section">
                <div class="school-logo">
                    <img src="<%= schoolLogo %>" alt="School Logo">
                </div>
                <div class="school-name">P.P.M.H.S.S. KOTTUKKARA</div>
                <div class="report-title">PROGRESS REPORT - <%= academicYear %></div>
                <!-- <div class="exam-info" style="font-size: 11px; font-weight: bold; margin-top: 3px;">Exam: <%= examName %></div> -->
                <div class="report-title" style="font-size: 12px; margin-top: 1px;"><%= examName %></div>
            </div>
            
            <!-- Student Info -->
            <div class="student-info">
                <div class="info-row">
                    <span class="info-label">Name</span>
                    <span class="info-value">: <%= student.name %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Class & Division</span>
                    <span class="info-value">: <%= student.class %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Admission No.</span>
                    <span class="info-value">: <%= student.admissionNo %></span>
                </div>
                <div class="info-row">
                    <span class="info-label">Roll Number</span>
                    <span class="info-value">: <%= student.rollNumber %></span>
                </div>
            </div>
            
            <!-- Marks Table -->
            <% if (subjects && subjects.length > 0) { %>
            <table class="marks-table">
                <thead>
                    <tr>
                        <th rowspan="2">SUBJECT</th>
                        <th colspan="2">Max. Score</th>
                        <th colspan="2">Score Obtained</th>
                        <th rowspan="2">TOTAL</th>
                        <th rowspan="2">TE GRADE</th>
                    </tr>
                    <tr>
                        <th>CE</th>
                        <th>TE</th>
                        <th>CE</th>
                        <th>TE</th>
                    </tr>
                </thead>
                <tbody>
                <% 
                let totalCEMax = 0;
                let totalTEMax = 0;
                let totalCE = 0;
                let totalTE = 0;
                
                subjects.forEach(function(subject) {
                    totalCEMax += subject.ceMax;
                    totalTEMax += subject.teMax;
                    totalCE += subject.ceMarks;
                    totalTE += subject.teMarks;
                %>
                <tr>
                    <td><%= subject.name %></td>
                    <td><%= subject.ceMax %></td>
                    <td><%= subject.teMax %></td>
                    <td><%= subject.ceMarks %></td>
                    <td><%= subject.teMarks %></td>
                    <td><%= subject.total %></td>
                    <td><%= subject.grade %></td>
                </tr>
                <% }); %>
                
                <% 
                const grandTotal = totalCE + totalTE;
                const grandMax = totalCEMax + totalTEMax;
                const overallPercentage = grandMax > 0 ? Math.round((grandTotal / grandMax) * 100) : 0;
                %>
                <tr class="total-row">
                    <td><strong>TOTAL</strong></td>
                    <td><strong><%= totalCEMax %></strong></td>
                    <td><strong><%= totalTEMax %></strong></td>
                    <td><strong><%= totalCE %></strong></td>
                    <td><strong><%= totalTE %></strong></td>
                    <td><strong><%= grandTotal %></strong></td>
                    <td><strong><%= overallGrade %></strong></td>
                </tr>
                </tbody>
            </table>
            <% } else { %>
            <div style="text-align: center; padding: 20px; color: #999; font-style: italic;">
                No marks available for this student
            </div>
            <% } %>
            
            <!-- Remarks Section -->
            <div class="remarks-section">
                <span class="remarks-label">Remarks :</span>
                <span class="remarks-line"></span>
            </div>
            
        </div>
        
        <!-- Bottom Section -->
        <div class="bottom-section">
            
            <!-- Signatures -->
            <div class="signature-section">
                <div class="signature-item">
                    <div class="signature-label">Class Teacher</div>
                    <div class="signature-line"></div>
                </div>
                <div class="signature-item">
                    <div class="signature-label">Principal</div>
                    <div class="signature-line"></div>
                </div>
                <div class="signature-item">
                    <div class="signature-label">Parent's Signature</div>
                    <div class="signature-line"></div>
                </div>
            </div>
            
            <!-- Instructions Section -->
            <!-- <div class="instructions-section">
                <div class="instructions-title">Instructions :</div>
                <ul class="instructions-list">
                    <li>1. This progress report is valid only with the school seal and authorized signature.</li>
                    <li>2. Any corrections or overwriting must be authenticated by the Principal.</li>
                    <li>3. This document should be preserved carefully for future reference.</li>
                    <li>4. For any queries regarding marks, contact the school office within 10 working days.</li>
                    <li>5. Duplicate progress report will be issued only on submission of proper application.</li>
                    <li>6. Minimum attendance required for eligibility is 75%.</li>
                    <li>7. Parents are requested to sign and return the acknowledgement copy to the class teacher.</li>
                    <li>8. Parent-Teacher Meeting schedule will be communicated separately.</li>
                </ul>
            </div> -->
            
            <!-- Grade Legend -->
            <!-- <div class="grade-legend">
                <div class="legend-title">GRADE BOUNDARIES:</div>
                <div class="legend-text">
                    A+ (90-100) | A (80-89) | B+ (70-79) | B (60-69) | C+ (50-59) | C (40-49) | D+ (30-39) | D (20-29) | E (Below 20)
                </div>
                <div class="legend-text" style="margin-top: 3px;">
                    CE: Continuous Evaluation (20%) | TE: Term Evaluation (80%) | Overall Grade: <%= overallGrade %>
                </div>
            </div> -->
            
            <!-- Bottom Info Row -->
            <div class="bottom-info-row">
                <div class="grade-info">
                    Promoted to next class on: ___________________
                </div>
                <div class="generated-info">
                    Generated on: <%= new Date().toLocaleDateString('en-IN') %>
                </div>
            </div>
            
        </div>
        
    </div>
</div>

</body>
</html>