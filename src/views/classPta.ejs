<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Class PTA - <%= className %> <%= academicYear %></title>

<style>
@page {
    size: A4 portrait;
    margin: 5mm;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    width: 210mm;
    font-family: "Times New Roman", serif;
    background: #fff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}

.page-container {
    width: 200mm;
    height: 285mm;
    max-height: 285mm;
    margin: 0 auto 5mm auto;
    padding: 7mm 5mm 6mm 5mm;
    border: 2px solid #000;
    position: relative;
    page-break-after: always;
    page-break-inside: avoid;
    box-sizing: border-box;
    background: #fff;
    display: flex;
    flex-direction: column;
}

.page-container:last-child {
    page-break-after: auto;
    margin-bottom: 0;
}

/* Logo Watermark */
.logo-watermark {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    pointer-events: none;
}

.logo-watermark img {
    width: 120mm;
    height: 120mm;
    object-fit: contain;
    opacity: 0.06;
}

.content-layer {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
}

/* Main content */
.main-content {
    flex: 1;
}

/* Header Section */
.header-section {
    text-align: center;
    margin-bottom: 6px;
    padding-bottom: 4px;
    border-bottom: 2px solid #000;
}

.school-logo {
    width: 14mm;
    height: 14mm;
    margin: 0 auto 2px;
}

.school-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.school-name {
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 1px;
}

.arabic-text {
    font-size: 9px;
    font-weight: bold;
    margin-bottom: 2px;
    color: #333;
}

.main-title {
    font-size: 14.5px;
    font-weight: 900;
    text-transform: uppercase;
    text-decoration: underline;
    margin: 2px 0;
}

.class-info {
    font-size: 11px;
    font-weight: 700;
    margin-top: 1px;
}

.page-number {
    text-align: center;
    font-size: 8.5px;
    margin-top: 3px;
    font-weight: bold;
}

/* Main Table */
.main-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 10.5px;
    margin-top: 2px;
    table-layout: fixed;
}

.main-table th,
.main-table td {
    border: 1.5px solid #000;
    padding: 0 4px;
    text-align: center;
    vertical-align: middle;
    height: 7.7mm;
    box-sizing: border-box;
}

.main-table th {
    background: #f0f0f0;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 9px;
    height: 6.5mm;
    letter-spacing: 0.3px;
}

.main-table td {
    background: transparent;
    font-size: 10.5px;
}

/* Column widths */
.main-table .sl-col { width: 8%; }
.main-table .adm-col { width: 11%; }
.main-table .name-col { width: 28%; text-align: left; padding-left: 6px; }
.main-table .parent-col { width: 27%; text-align: left; padding-left: 6px; }
.main-table .sign-col { width: 26%; }

/* Bottom Section */
.bottom-section {
    margin-top: auto;
    padding-top: 4px;
}

/* Signature Section */
.signature-section {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 6px;
    margin-bottom: 4px;
}

.signature-item {
    text-align: center;
    width: 140px;
}

.signature-line {
    margin-top: 18px;
    border-top: 1.5px solid #000;
    width: 100%;
}

.signature-label {
    font-size: 9.5px;
    font-weight: bold;
    margin-top: 3px;
}

/* Footer */
.footer {
    margin-top: 4px;
    padding-top: 3px;
    border-top: 1px solid #000;
    overflow: hidden;
    font-size: 8.5px;
}

.total-students {
    float: left;
    font-weight: 700;
}

.generated-info {
    float: right;
}

/* Print optimization */
@media print {
    html, body {
        width: 210mm;
        margin: 0;
        padding: 0;
    }
    
    th {
        background: #f0f0f0 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    
    td {
        background: transparent !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
    
    .page-container {
        border: 2px solid #000;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
        page-break-after: always;
        page-break-inside: avoid;
    }
    
    .logo-watermark img {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
}
</style>
</head>

<body>

<%
const studentsPerPage = 25;

// Sort roll number wise numerically
const sortedStudents = [...students].sort((a, b) => {
    const getRoll = (s) => {
        if (!s) return null;
        const raw = s.rollNumber ?? s.rollNo ?? s.slNo;
        if (raw === null || raw === undefined || raw === '') return null;
        const parsed = parseInt(String(raw).trim(), 10);
        return isNaN(parsed) ? String(raw).trim() : parsed;
    };

    const rollA = getRoll(a);
    const rollB = getRoll(b);

    const hasRollA = rollA !== null && rollA !== '';
    const hasRollB = rollB !== null && rollB !== '';

    if (hasRollA && hasRollB) {
        if (typeof rollA === 'number' && typeof rollB === 'number') {
            if (rollA !== rollB) return rollA - rollB;
        } else {
            const comp = String(rollA).localeCompare(String(rollB), undefined, { numeric: true, sensitivity: 'base' });
            if (comp !== 0) return comp;
        }
    } else if (hasRollA && !hasRollB) {
        return -1;
    } else if (!hasRollA && hasRollB) {
        return 1;
    }

    const nameA = a.name || a.fullName || '';
    const nameB = b.name || b.fullName || '';
    return nameA.localeCompare(nameB);
});

// Single continuous list of pages - do not separate boys and girls
const pagesData = [];
const totalStudentsCount = sortedStudents.length;
const totalPages = Math.max(1, Math.ceil(totalStudentsCount / studentsPerPage));

for (let p = 0; p < totalPages; p++) {
    const start = p * studentsPerPage;
    const pageStudents = sortedStudents.slice(start, start + studentsPerPage).map((s, idx) => {
        const autoRoll = start + idx + 1;
        const displayRoll = s.rollNumber || s.rollNo || s.slNo || autoRoll;
        return {
            ...s,
            displayRollNo: displayRoll
        };
    });
    pagesData.push(pageStudents);
}

const displayAcademicYear = typeof academicYear !== 'undefined' ? academicYear : '2025-2026';
const displayClassName = typeof className !== 'undefined' ? className : '10 A';
const schoolLogo = typeof schoolLogoUrl !== 'undefined' ? schoolLogoUrl : 'https://res.cloudinary.com/dmjqgjcut/image/upload/v1769946977/school-logo_uugskb.jpg';

for (let page = 0; page < totalPages; page++) {
    const pageStudents = pagesData[page];
    const isLastPage = page === totalPages - 1;
%>

<div class="page-container">
    
    <!-- Logo Watermark -->
    <div class="logo-watermark">
        <img src="<%= schoolLogo %>" alt="Watermark">
    </div>
    
    <div class="content-layer">
        
        <div class="main-content">
            
            <!-- Header -->
            <div class="header-section">
                <div class="school-logo">
                    <img src="<%= schoolLogo %>" alt="School Logo">
                </div>
                <div class="school-name">P.P.M.H.S.S. KOTTUKKARA</div>
                <div class="main-title">Class PTA</div>
                <div class="class-info">(Standard and Division - <%= displayClassName %> <%= displayAcademicYear %>)</div>
            </div>
            
            <!-- Main Table -->
            <table class="main-table">
                <thead>
                    <tr>
                        <th class="sl-col">Roll No</th>
                        <th class="adm-col">Adm No</th>
                        <th class="name-col">Name of Student</th>
                        <th class="parent-col">Name of Parent/Guardian</th>
                        <th class="sign-col">Signature of Parent</th>
                    </tr>
                </thead>
                <tbody>
                    <% pageStudents.forEach(function(student) { %>
                    <tr>
                        <td><%= student.displayRollNo %></td>
                        <td><%= student.admissionNo || '' %></td>
                        <td class="name-col"><%= student.name || '' %></td>
                        <td class="parent-col"><%= student.parentName || '' %></td>
                        <td class="sign-col"></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            
        </div>
        
        <!-- Bottom Section -->
        <div class="bottom-section">
            
            <!-- Signatures - Only on Last Page -->
            <% if (isLastPage) { %>
            <div class="signature-section">
                <div class="signature-item">
                    <div class="signature-label">Class Teacher</div>
                    <div class="signature-line"></div>
                </div>
                <div class="signature-item">
                    <div class="signature-label">PTA President</div>
                    <div class="signature-line"></div>
                </div>
                <div class="signature-item">
                    <div class="signature-label">Headmaster</div>
                    <div class="signature-line"></div>
                </div>
            </div>
            <% } %>
            
            <!-- Footer -->
            <div class="footer">
                <span class="total-students">Total Students: <%= totalStudentsCount %></span>
                <span class="generated-info">Generated on: <%= new Date().toLocaleDateString('en-IN') %></span>
            </div>
            
        </div>
        
        <div class="page-number">Page <%= page + 1 %> of <%= totalPages %></div>
        
    </div>
</div>

<% } %>

</body>
</html>