<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Class Marks - <%= className %></title>
<style>
@page {
    size: A4 landscape;
    margin: 8mm;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: "Times New Roman", serif;
    background: #fff;
    color: #0F172A;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    font-size: 10px;
}

/* Watermark */
.logo-watermark {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 160mm;
    height: 160mm;
    opacity: 0.08;
    z-index: -1;
    pointer-events: none;
}

.logo-watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

/* Page Frame Container */
.table-container {
    width: 100%;
    padding: 4px;
}

/* Header Section inside thead to repeat on every page */
.school-header-cell {
    border: none !important;
    padding: 0 0 10px 0 !important;
    text-align: center;
    background: #fff !important;
}

.header-content {
    text-align: center;
    margin-bottom: 8px;
    border-bottom: 2px double #1E3A8A;
    padding-bottom: 8px;
}

.school-logo {
    width: 20mm;
    height: 20mm;
    margin: 0 auto 4px;
}

.school-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.school-name {
    font-size: 18px;
    font-weight: 900;
    color: #1E3A8A;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2px;
}

.school-address {
    font-size: 9.5px;
    font-weight: bold;
    color: #475569;
    margin-bottom: 6px;
}

.report-title {
    font-size: 13px;
    font-weight: 800;
    color: #1E3A8A;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: #EFF6FF;
    padding: 4px 16px;
    display: inline-block;
    border-radius: 4px;
    border: 1px solid #BFDBFE;
}

.info-grid {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    margin-bottom: 6px;
    font-size: 10px;
    border: 1px solid #CBD5E1;
    padding: 6px 12px;
    background: #F8FAFC;
    border-radius: 4px;
}

.info-item {
    display: flex;
    gap: 6px;
}

.info-label {
    font-weight: bold;
    color: #1E3A8A;
}

/* Table */
table {
    width: 100%;
    border-collapse: collapse;
    font-size: 9px;
    page-break-inside: auto;
}

tr {
    page-break-inside: avoid;
    page-break-after: auto;
}

tr:nth-child(even) td {
    background-color: #F8FAFC;
}

thead {
    display: table-header-group;
}

tfoot {
    display: table-footer-group;
}

th, td {
    border: 1px solid #94A3B8;
    padding: 4px 3px;
    text-align: center;
    vertical-align: middle;
}

th.col-header {
    background-color: #1E3A8A;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 9px;
    padding: 6px 2px;
    border: 1px solid #0F172A;
}

th.col-header div {
    color: #FFFFFF;
}

td.text-left {
    text-align: left;
    padding-left: 6px;
}

.ab {
    color: #DC2626;
    font-weight: bold;
}
.not-entered {
    color: #94A3B8;
}
.bold {
    font-weight: bold;
}

/* Footer */
.footer-cell {
    border: none !important;
    text-align: right;
    padding-top: 8px !important;
    font-size: 8px;
    color: #64748B;
    background: transparent !important;
}
</style>
</head>
<body>
    <!-- Watermark -->
    <div class="logo-watermark">
        <% if (schoolLogo) { %>
            <img src="<%= schoolLogo %>" alt="Watermark" />
        <% } %>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <!-- School Header (spans all columns) -->
                <tr>
                    <th class="school-header-cell" colspan="<%= subjects.length + 6 %>">
                        <div class="header-content">
                            <% if (schoolLogo) { %>
                                <div class="school-logo">
                                    <img src="<%= schoolLogo %>" alt="School Logo" />
                                </div>
                            <% } %>
                            <div class="school-name">PPM HIGHER SECONDARY SCHOOL</div>
                            <div class="school-address">KOTTUKKARA, KONDOTTY, MALAPPURAM, KERALA 673638</div>
                            <div class="report-title">CLASS MARKS OVERVIEW</div>
                        </div>

                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">CLASS:</span>
                                <span><%= className %></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">EXAM:</span>
                                <span><%= examName %></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">ACADEMIC YEAR:</span>
                                <span><%= academicYear %></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">TOTAL STUDENTS:</span>
                                <span><%= totalStudents %></span>
                            </div>
                        </div>
                    </th>
                </tr>
                
                <!-- Table Column Headers -->
                <tr>
                    <th class="col-header" style="width: 4%">Roll No</th>
                    <th class="col-header" style="width: 16%">Student</th>
                    <% subjects.forEach(function(subj) { %>
                        <th class="col-header">
                            <div><%= subj.displayName || subj.subjectName %></div>
                            <div style="font-weight: normal; font-size: 7.5px; opacity: 0.9; margin-top: 2px;">Max: <%= subj.maxMarks || 100 %></div>
                        </th>
                    <% }); %>
                    <th class="col-header" style="width: 6%">Total</th>
                    <th class="col-header" style="width: 5%">%</th>
                    <th class="col-header" style="width: 4%">Grade</th>
                    <th class="col-header" style="width: 4%">Rank</th>
                </tr>
            </thead>
            <tbody>
                <% students.forEach(function(student, idx) { %>
                    <tr>
                        <td class="bold"><%= student.rollNo || student.rollNumber || student.slNo || (idx + 1) %></td>
                        <td class="text-left">
                            <div class="bold"><%= student.name || student.studentName || student.fullName %></div>
                            <% if(student.admissionNo || student.studentCode) { %>
                                <div style="font-size: 7.5px; color: #64748B;"><%= student.admissionNo || student.studentCode %></div>
                            <% } %>
                        </td>
                        <% subjects.forEach(function(examSubj) { %>
                            <% 
                               var sm = student.subjects ? student.subjects.find(function(s) { 
                                   return (s.examSubjectId && (s.examSubjectId.toString() === examSubj.examSubjectId.toString())) ||
                                          (s.subjectId && (s.subjectId.toString() === (examSubj.subjectId ? examSubj.subjectId.toString() : '')));
                               }) : null;
                               
                               if (!sm && student.subjectMarks) {
                                   sm = student.subjectMarks.find(function(s) {
                                       return (s.examSubjectId && (s.examSubjectId.toString() === examSubj.examSubjectId.toString())) ||
                                              (s.subjectId && (s.subjectId.toString() === (examSubj.subjectId ? examSubj.subjectId.toString() : '')));
                                   });
                               }
                            %>
                            <td>
                                <% if(sm) { %>
                                    <% if(sm.isAbsent) { %>
                                        <span class="ab">AB</span>
                                    <% } else if(!sm.isEntered) { %>
                                        <span class="not-entered">—</span>
                                    <% } else { %>
                                        <span class="bold"><%= sm.totalScore !== undefined ? sm.totalScore : sm.total %></span>
                                    <% } %>
                                <% } else { %>
                                    <span class="not-entered">—</span>
                                <% } %>
                            </td>
                        <% }); %>
                        <td class="bold" style="background-color: #EFF6FF;"><%= student.totalObtained !== undefined ? student.totalObtained : student.totalMarks %> / <%= student.totalMax !== undefined ? student.totalMax : student.totalMaxMarks %></td>
                        <td class="bold" style="background-color: #EFF6FF;"><%= (student.percentage !== undefined ? student.percentage : 0).toFixed(1) %>%</td>
                        <td class="bold" style="background-color: #EFF6FF;"><%= student.gradeInfo ? student.gradeInfo.grade : (student.grade || '-') %></td>
                        <td class="bold" style="background-color: #EFF6FF;"><%= student.rank || '-' %></td>
                    </tr>
                <% }); %>
            </tbody>
            <tfoot>
                <tr>
                    <td class="footer-cell" colspan="<%= subjects.length + 6 %>">
                        Generated on <%= new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %> | PPM Higher Secondary School
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</body>
</html>
