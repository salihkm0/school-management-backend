<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Class Marks - <%= className %></title>
<style>
@page {
    size: A4 landscape;
    margin: 5mm;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    width: 287mm; /* landscape width */
    font-family: "Times New Roman", serif;
    background: #fff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}

.page-container {
    width: 277mm;
    min-height: 190mm;
    margin: 0 auto;
    padding: 10mm;
    position: relative;
    box-sizing: border-box;
    background: #fff;
    display: flex;
    flex-direction: column;
}

/* Logo Watermark */
.logo-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140mm;
    height: 140mm;
    opacity: 0.04;
    z-index: 1;
    pointer-events: none;
}

.logo-watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.content-layer {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
}

/* Header Section */
.header-section {
    text-align: center;
    margin-bottom: 20px;
    border-bottom: 2px solid #333;
    padding-bottom: 15px;
}

.school-logo {
    width: 20mm;
    height: 20mm;
    margin: 0 auto 5px;
}

.school-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.school-name {
    font-size: 16px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.school-address {
    font-size: 9px;
    margin-bottom: 5px;
    font-weight: bold;
}

.report-title {
    font-size: 12px;
    font-weight: bold;
    text-transform: uppercase;
    margin-top: 10px;
}

/* Info Grid */
.info-grid {
    display: flex;
    justify-content: space-between;
    margin-bottom: 15px;
    font-size: 10px;
    border: 1px solid #000;
    padding: 8px;
    background: #f9f9f9;
}

.info-item {
    display: flex;
    gap: 10px;
}

.info-label {
    font-weight: bold;
}

/* Table */
table {
    width: 100%;
    border-collapse: collapse;
    font-size: 9px;
    margin-bottom: 20px;
}

th, td {
    border: 1px solid #000;
    padding: 5px;
    text-align: center;
    vertical-align: middle;
}

th {
    background-color: #f0f0f0;
    font-weight: bold;
}

td.text-left {
    text-align: left;
}

.ab {
    color: #d32f2f;
    font-weight: bold;
}
.not-entered {
    color: #9e9e9e;
}
.bold {
    font-weight: bold;
}

/* Footer */
.footer {
    margin-top: auto;
    font-size: 8px;
    text-align: right;
    color: #666;
}
</style>
</head>
<body>
    <div class="page-container">
        <!-- Watermark -->
        <div class="logo-watermark">
            <% if (schoolLogo) { %>
                <img src="<%= schoolLogo %>" alt="Watermark" />
            <% } %>
        </div>

        <div class="content-layer">
            <!-- Header -->
            <div class="header-section">
                <% if (schoolLogo) { %>
                    <div class="school-logo">
                        <img src="<%= schoolLogo %>" alt="School Logo" />
                    </div>
                <% } %>
                <div class="school-name">PPM HIGHER SECONDARY SCHOOL</div>
                <div class="school-address">KOTTUKKARA, KONDOTTY, MALAPPURAM, KERALA 673638</div>
                <div class="report-title">CLASS MARKS OVERVIEW</div>
            </div>

            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">CLASS:</span>
                    <span><%= className %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">EXAM:</span>
                    <span><%= examName %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">ACADEMIC YEAR:</span>
                    <span><%= academicYear %></span>
                </div>
                <div class="info-item">
                    <span class="info-label">TOTAL STUDENTS:</span>
                    <span><%= totalStudents %></span>
                </div>
            </div>

            <table>
                <thead>
                    <tr>
                        <th style="width: 3%">Rank</th>
                        <th style="width: 15%">Student</th>
                        <% subjects.forEach(function(subj) { %>
                            <th>
                                <div><%= subj.displayName || subj.subjectName %></div>
                                <div style="font-weight: normal; font-size: 8px; margin-top: 2px;">Max: <%= subj.maxMarks || 100 %></div>
                            </th>
                        <% }); %>
                        <th style="width: 6%">Total</th>
                        <th style="width: 5%">%</th>
                        <th style="width: 5%">Grade</th>
                    </tr>
                </thead>
                <tbody>
                    <% students.forEach(function(student) { %>
                        <tr>
                            <td class="bold"><%= student.rank || '-' %></td>
                            <td class="text-left">
                                <div class="bold"><%= student.name || student.studentName || student.fullName %></div>
                                <% if(student.admissionNo) { %><div style="font-size: 7px; color: #555;"><%= student.admissionNo %></div><% } %>
                            </td>
                            <% subjects.forEach(function(examSubj) { %>
                                <% 
                                   // Find the mark for this exact subject in the student's subjects array
                                   var sm = student.subjects ? student.subjects.find(function(s) { 
                                       return s.examSubjectId && (s.examSubjectId.toString() === examSubj.examSubjectId.toString()) 
                                   }) : null;
                                   
                                   if (!sm && student.subjectMarks) {
                                       sm = student.subjectMarks.find(function(s) {
                                           return s.examSubjectId && (s.examSubjectId.toString() === examSubj.examSubjectId.toString());
                                       });
                                   }
                                %>
                                <td>
                                    <% if(sm) { %>
                                        <% if(sm.isAbsent) { %>
                                            <span class="ab">AB</span>
                                        <% } else if(!sm.isEntered) { %>
                                            <span class="not-entered">—</span>
                                        <% } else { %>
                                            <span class="bold"><%= sm.totalScore !== undefined ? sm.totalScore : sm.total %></span>
                                        <% } %>
                                    <% } else { %>
                                        <span class="not-entered">—</span>
                                    <% } %>
                                </td>
                            <% }); %>
                            <td class="bold" style="background-color: #f9f9f9;"><%= student.totalObtained !== undefined ? student.totalObtained : student.totalMarks %> / <%= student.totalMax !== undefined ? student.totalMax : student.totalMaxMarks %></td>
                            <td class="bold" style="background-color: #f9f9f9;"><%= (student.percentage !== undefined ? student.percentage : 0).toFixed(1) %>%</td>
                            <td class="bold" style="background-color: #f9f9f9;"><%= student.gradeInfo ? student.gradeInfo.grade : student.grade %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
            
            <div class="footer">
                Generated on <%= new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
            </div>
        </div>
    </div>
</body>
</html>
