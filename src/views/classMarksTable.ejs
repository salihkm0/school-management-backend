<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Class Marks - <%= className %></title>
<style>
@page {
    size: A4 landscape;
    margin: 8mm;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: "Times New Roman", serif;
    background: #fff;
    color: #000000;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    font-size: 10px;
}

/* Watermark */
.logo-watermark {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 160mm;
    height: 160mm;
    opacity: 0.04;
    z-index: -1;
    pointer-events: none;
}

.logo-watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
}

/* Page Frame Container */
.table-container {
    width: 100%;
    padding: 4px;
}

/* Header Section inside thead to repeat on every page */
.school-header-cell {
    border: none !important;
    padding: 0 0 10px 0 !important;
    text-align: center;
    background: #fff !important;
}

.header-content {
    text-align: center;
    margin-bottom: 8px;
    border-bottom: 2px double #000000;
    padding-bottom: 8px;
}

.school-logo {
    width: 20mm;
    height: 20mm;
    margin: 0 auto 4px;
}

.school-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(100%);
}

.school-name {
    font-size: 18px;
    font-weight: 900;
    color: #000000;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 2px;
}

.school-address {
    font-size: 9.5px;
    font-weight: bold;
    color: #222222;
    margin-bottom: 6px;
}

.report-title {
    font-size: 13px;
    font-weight: 900;
    color: #000000;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    background: #f5f5f5;
    padding: 4px 16px;
    display: inline-block;
    border-radius: 3px;
    border: 1.5px solid #000000;
}

.info-grid {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    margin-bottom: 6px;
    font-size: 10px;
    border: 1px solid #000000;
    padding: 6px 12px;
    background: #FAFAFA;
    border-radius: 3px;
    color: #000000;
}

.info-item {
    display: flex;
    gap: 6px;
}

.info-label {
    font-weight: bold;
    color: #000000;
}

/* Table */
table {
    width: 100%;
    border-collapse: collapse;
    font-size: 9px;
    page-break-inside: auto;
}

tr {
    page-break-inside: avoid;
    page-break-after: auto;
}

tr:nth-child(even) td {
    background-color: #F8F8F8;
}

thead {
    display: table-header-group;
}

tfoot {
    display: table-footer-group;
}

th, td {
    border: 1px solid #000000;
    padding: 4px 3px;
    text-align: center;
    vertical-align: middle;
    color: #000000;
}

th.col-header {
    background-color: #ECECEC;
    color: #000000;
    font-weight: bold;
    font-size: 9px;
    padding: 6px 2px;
    border: 1px solid #000000;
}

th.col-header div {
    color: #000000;
}

td.text-left {
    text-align: left;
    padding-left: 6px;
}

.ab {
    color: #000000;
    font-weight: 900;
}
.not-entered {
    color: #555555;
}
.bold {
    font-weight: bold;
}
.grade-pill {
    display: inline-block;
    font-size: 7.5px;
    font-weight: bold;
    padding: 1px 4px;
    border-radius: 2px;
    background: #F0F0F0;
    color: #000000;
    border: 0.5px solid #777777;
    margin-top: 1px;
}
.grade-te {
    background: #F0F0F0;
    color: #000000;
    border: 0.5px solid #777777;
}
.cell-both {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-size: 7.5px;
    line-height: 1.2;
}

/* Footer */
.footer-cell {
    border: none !important;
    text-align: right;
    padding-top: 8px !important;
    font-size: 8px;
    color: #333333;
    background: transparent !important;
}
</style>
</head>
<body>
    <% const viewMode = typeof mode !== 'undefined' ? mode : 'total'; %>
    <!-- Watermark -->
    <div class="logo-watermark">
        <% if (schoolLogo) { %>
            <img src="<%= schoolLogo %>" alt="Watermark" />
        <% } %>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <!-- School Header (spans all columns) -->
                <tr>
                    <th class="school-header-cell" colspan="<%= subjects.length + 6 %>">
                        <div class="header-content">
                            <% if (schoolLogo) { %>
                                <div class="school-logo">
                                    <img src="<%= schoolLogo %>" alt="School Logo" />
                                </div>
                            <% } %>
                            <div class="school-name">PPM HIGHER SECONDARY SCHOOL</div>
                            <div class="school-address">KOTTUKKARA, KONDOTTY, MALAPPURAM, KERALA 673638</div>
                            <div class="report-title">
                                <% if (viewMode === 'te') { %>
                                    CLASS MARKS OVERVIEW (TE MARKS & GRADE)
                                <% } else if (viewMode === 'both') { %>
                                    CLASS MARKS OVERVIEW (TE & TE+CE MARKS & GRADE)
                                <% } else { %>
                                    CLASS MARKS OVERVIEW (TE+CE TOTAL MARKS & GRADE)
                                <% } %>
                            </div>
                        </div>

                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">CLASS:</span>
                                <span><%= className %></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">EXAM:</span>
                                <span><%= examName %></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">ACADEMIC YEAR:</span>
                                <span><%= academicYear %></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">TOTAL STUDENTS:</span>
                                <span><%= totalStudents %></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">VIEW MODE:</span>
                                <span><%= viewMode === 'te' ? 'TE Marks & Grade' : (viewMode === 'both' ? 'Both (TE & TE+CE)' : 'TE+CE Total Marks & Grade') %></span>
                            </div>
                        </div>
                    </th>
                </tr>
                
                <!-- Table Column Headers -->
                <tr>
                    <th class="col-header" style="width: 4%">Roll No</th>
                    <th class="col-header" style="width: 15%">Student</th>
                    <% subjects.forEach(function(subj) { %>
                        <th class="col-header">
                            <div><%= subj.displayName || subj.subjectName %></div>
                            <% if (viewMode === 'te') { %>
                                <div style="font-weight: 600; font-size: 7.5px; color: #444444; margin-top: 2px;">TE Max: <%= subj.teMax %></div>
                            <% } else if (viewMode === 'both') { %>
                                <div style="font-weight: 600; font-size: 7px; color: #444444; margin-top: 2px;">TE:<%= subj.teMax %> | Tot:<%= subj.totalMax %></div>
                            <% } else { %>
                                <div style="font-weight: 600; font-size: 7.5px; color: #444444; margin-top: 2px;">Max: <%= subj.totalMax || subj.maxMarks || 100 %></div>
                            <% } %>
                        </th>
                    <% }); %>
                    <th class="col-header" style="width: 7%">
                        <%= viewMode === 'te' ? 'TE Total' : (viewMode === 'both' ? 'Total (TE/Tot)' : 'Total') %>
                    </th>
                    <th class="col-header" style="width: 5%"><%= viewMode === 'te' ? 'TE %' : '%' %></th>
                    <th class="col-header" style="width: 5%"><%= viewMode === 'te' ? 'TE Grade' : 'Grade' %></th>
                    <th class="col-header" style="width: 4%">Rank</th>
                </tr>
            </thead>
            <tbody>
                <% students.forEach(function(student, idx) { %>
                    <tr>
                        <td class="bold"><%= student.rollNo || student.rollNumber || student.slNo || (idx + 1) %></td>
                        <td class="text-left">
                            <div class="bold"><%= student.name || student.studentName || student.fullName %></div>
                            <% if(student.admissionNo || student.studentCode) { %>
                                <div style="font-size: 7.5px; color: #64748B;"><%= student.admissionNo || student.studentCode %></div>
                            <% } %>
                        </td>
                        <% subjects.forEach(function(examSubj) { %>
                            <% 
                               var sm = student.subjects ? student.subjects.find(function(s) { 
                                   return (s.examSubjectId && (s.examSubjectId.toString() === examSubj.examSubjectId.toString())) ||
                                          (s.subjectId && (s.subjectId.toString() === (examSubj.subjectId ? examSubj.subjectId.toString() : '')));
                               }) : null;
                               
                               if (!sm && student.subjectMarks) {
                                   sm = student.subjectMarks.find(function(s) {
                                       return (s.examSubjectId && (s.examSubjectId.toString() === examSubj.examSubjectId.toString())) ||
                                              (s.subjectId && (s.subjectId.toString() === (examSubj.subjectId ? examSubj.subjectId.toString() : '')));
                                   });
                               }
                            %>
                            <td>
                                <% if(sm) { %>
                                    <% 
                                       var currentTotalMarks = sm.totalMarks !== undefined ? sm.totalMarks : (sm.totalScore !== undefined ? sm.totalScore : sm.total);
                                       var currentTotalGrade = sm.totalGrade || sm.grade || '-';
                                    %>
                                    <% if(sm.isAbsent) { %>
                                        <% if (viewMode === 'te') { %>
                                            <span class="ab">AB</span>
                                        <% } else if (viewMode === 'both') { %>
                                            <div class="cell-both">
                                                <div><strong>TE:</strong> <span class="ab">AB</span></div>
                                                <div style="border-top: 0.5px solid #777777; padding-top: 1px;">
                                                    <strong>Tot:</strong> 
                                                    <% if (currentTotalMarks > 0) { %>
                                                        <%= currentTotalMarks %> (<%= currentTotalGrade %>)
                                                    <% } else { %>
                                                        <span class="ab">AB</span>
                                                    <% } %>
                                                </div>
                                            </div>
                                        <% } else { %>
                                            <% if (currentTotalMarks > 0) { %>
                                                <div class="bold"><%= currentTotalMarks %></div>
                                                <div class="grade-pill"><%= currentTotalGrade %></div>
                                            <% } else { %>
                                                <span class="ab">AB</span>
                                            <% } %>
                                        <% } %>
                                    <% } else if(!sm.isEntered && sm.total === undefined && sm.totalScore === undefined) { %>
                                        <span class="not-entered">—</span>
                                    <% } else { %>
                                        <% if (viewMode === 'te') { %>
                                            <div class="bold"><%= sm.teMarks !== undefined ? sm.teMarks : (sm.theoryScore !== undefined ? sm.theoryScore : 0) %></div>
                                            <div class="grade-pill grade-te"><%= sm.teGrade || '-' %></div>
                                        <% } else if (viewMode === 'both') { %>
                                            <div class="cell-both">
                                                <div><strong>TE:</strong> <%= sm.teMarks !== undefined ? sm.teMarks : (sm.theoryScore !== undefined ? sm.theoryScore : 0) %> (<%= sm.teGrade || '-' %>)</div>
                                                <div style="border-top: 0.5px solid #777777; padding-top: 1px;"><strong>Tot:</strong> <%= currentTotalMarks %> (<%= currentTotalGrade %>)</div>
                                            </div>
                                        <% } else { %>
                                            <div class="bold"><%= currentTotalMarks %></div>
                                            <div class="grade-pill"><%= currentTotalGrade %></div>
                                        <% } %>
                                    <% } %>
                                <% } else { %>
                                    <span class="not-entered">—</span>
                                <% } %>
                            </td>
                        <% }); %>

                        <% if (viewMode === 'te') { %>
                            <td class="bold" style="background-color: #F2F2F2;">
                                <%= student.teTotalObtained !== undefined ? student.teTotalObtained : student.totalObtained %> / <%= student.teTotalMax !== undefined ? student.teTotalMax : student.totalMax %>
                            </td>
                            <td class="bold" style="background-color: #F2F2F2;">
                                <%= (student.tePercentage !== undefined ? student.tePercentage : (student.percentage || 0)).toFixed(1) %>%
                            </td>
                            <td class="bold" style="background-color: #F2F2F2;">
                                <%= student.teGrade || student.gradeInfo?.grade || '-' %>
                            </td>
                            <td class="bold" style="background-color: #F2F2F2;">
                                <%= student.rank || '-' %>
                            </td>
                        <% } else if (viewMode === 'both') { %>
                            <td class="bold" style="background-color: #F2F2F2; font-size: 8px;">
                                <div>TE: <%= student.teTotalObtained %>/<%= student.teTotalMax %></div>
                                <div>Tot: <%= student.totalObtained %>/<%= student.totalMax %></div>
                            </td>
                            <td class="bold" style="background-color: #F2F2F2; font-size: 8px;">
                                <div><%= (student.percentage || 0).toFixed(1) %>%</div>
                                <div style="font-size: 7px; color: #444444;">TE: <%= (student.tePercentage || 0).toFixed(1) %>%</div>
                            </td>
                            <td class="bold" style="background-color: #F2F2F2; font-size: 8px;">
                                <div><%= student.grade || '-' %></div>
                                <div style="font-size: 7px; color: #444444;">TE: <%= student.teGrade || '-' %></div>
                            </td>
                            <td class="bold" style="background-color: #F2F2F2;">
                                <%= student.rank || '-' %>
                            </td>
                        <% } else { %>
                            <td class="bold" style="background-color: #F2F2F2;">
                                <%= student.totalObtained !== undefined ? student.totalObtained : student.totalMarks %> / <%= student.totalMax !== undefined ? student.totalMax : student.totalMaxMarks %>
                            </td>
                            <td class="bold" style="background-color: #F2F2F2;">
                                <%= (student.percentage !== undefined ? student.percentage : 0).toFixed(1) %>%
                            </td>
                            <td class="bold" style="background-color: #F2F2F2;">
                                <%= student.grade || (student.gradeInfo ? student.gradeInfo.grade : '-') %>
                            </td>
                            <td class="bold" style="background-color: #F2F2F2;">
                                <%= student.rank || '-' %>
                            </td>
                        <% } %>
                    </tr>
                <% }); %>
            </tbody>
            <tfoot>
                <tr>
                    <td class="footer-cell" colspan="<%= subjects.length + 6 %>">
                        Generated on <%= new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %> | PPM Higher Secondary School
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</body>
</html>
