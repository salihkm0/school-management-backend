<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Sports Meet Entry Form - <%= className %> <%= academicYear %></title>

<style>
@page {
    size: A4 landscape;
    margin: 3mm;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    margin: 0;
    padding: 0;
    width: 297mm;
    font-family: "Times New Roman", serif;
    background: #fff;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
}

.page-container {
    width: 291mm;
    height: 200mm;
    max-height: 200mm;
    margin: 0 auto;
    padding: 2.5mm 4mm;
    border: 1.5px solid #000;
    position: relative;
    page-break-after: always;
    page-break-inside: avoid;
    box-sizing: border-box;
    background: #fff;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.page-container:last-child {
    page-break-after: auto;
    margin-bottom: 0;
}

/* Logo Watermark - Centered */
.logo-watermark {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 1;
    pointer-events: none;
}

.logo-watermark img {
    width: 120mm;
    height: 120mm;
    object-fit: contain;
    opacity: 0.05;
}

.content-layer {
    position: relative;
    z-index: 2;
    height: 100%;
    display: flex;
    flex-direction: column;
    flex: 1;
    justify-content: space-between;
}

/* Main Content */
.main-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
}

/* Header Section */
.header-section {
    text-align: center;
    margin-bottom: 2px;
    padding-bottom: 2px;
    border-bottom: 1.5px solid #000;
}

.school-logo {
    width: 13mm;
    height: 13mm;
    margin: 0 auto 1px;
}

.school-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.school-name {
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    line-height: 1.1;
    margin-bottom: 1px;
}

.arabic-text {
    font-size: 9px;
    font-weight: bold;
    margin-bottom: 1px;
    color: #333;
    line-height: 1.1;
}

.main-title {
    font-size: 11.5px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    line-height: 1.1;
    margin-top: 1px;
}

.sub-title {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    text-decoration: underline;
    line-height: 1.1;
    margin: 1px 0 2px 0;
}

/* Info Bar */
.info-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 10px;
    font-weight: bold;
    padding: 3.5px 10px;
    min-height: 25px;
    background-color: #f8f9fa;
    border: 1.5px solid #000;
    border-radius: 2px;
    margin-top: 2px;
}

.info-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

/* Main Table */
.table-wrapper {
    flex: 1;
    display: flex;
    flex-direction: column;
    margin-top: 2px;
    min-height: 0;
}

.main-table {
    width: 100%;
    height: 100%;
    border-collapse: collapse;
    table-layout: fixed;
}

.main-table th,
.main-table td {
    border: 1px solid #000;
    padding: 2px 3px;
    vertical-align: middle;
}

.main-table th {
    background: #f0f0f0;
    font-weight: 900;
    text-transform: uppercase;
    font-size: 8px;
    text-align: center;
    line-height: 1.15;
    height: 23px;
}

.main-table td {
    font-size: 8.5px;
}

.text-center {
    text-align: center;
}

.text-left {
    text-align: left;
    padding-left: 5px !important;
}

.student-name {
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: 9px;
}

.tick-box {
    text-align: center;
    font-size: 9px;
    color: #999;
}

/* Zebra striping */
tbody tr:nth-child(even) td {
    background-color: #fafafa;
}

/* Column Widths */
.table-sub-junior .col-sl { width: 4%; }
.table-sub-junior .col-adm { width: 7.5%; }
.table-sub-junior .col-name { width: 24.5%; }
.table-sub-junior .col-chest { width: 7%; }
.table-sub-junior .col-event { width: 7%; }
.table-sub-junior .col-remarks { width: 8%; }

.table-junior-senior .col-sl { width: 3.5%; }
.table-junior-senior .col-adm { width: 7%; }
.table-junior-senior .col-name { width: 19%; }
.table-junior-senior .col-chest { width: 6.5%; }
.table-junior-senior .col-event { width: 5.6%; }
.table-junior-senior .col-remarks { width: 8%; }

.table-junior-senior th {
    font-size: 7.5px;
}

.table-junior-senior td {
    font-size: 8px;
    padding: 2px 2px;
}

.table-junior-senior .student-name {
    font-size: 8.5px;
    padding-left: 4px !important;
}

/* Footer */
.footer-section {
    margin-top: 2px;
    padding-top: 2px;
}

.page-meta {
    display: flex;
    justify-content: space-between;
    font-size: 7.5px;
    color: #555;
    padding-top: 2px;
    border-top: 0.5px solid #ccc;
}

@media print {
    html, body {
        width: 297mm;
        height: 210mm;
    }
    .page-container {
        border: 2px solid #000;
        page-break-after: always;
    }
    .page-container:last-child {
        page-break-after: auto;
    }
    th {
        background-color: #f0f0f0 !important;
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
}
</style>
</head>
<body>

<%
// Events definition based on category
// Sub Junior (Class 8): 7 events (800 M removed as requested)
const subJuniorEvents = [
    '100 M',
    '200 M',
    '400 M',
    'Long Jump',
    'High Jump',
    'Shot Put',
    'Discus Throw'
];

// Junior (Class 9) & Senior (Class 10): 10 events
const juniorSeniorEvents = [
    '100 M',
    '200 M',
    '400 M',
    '800 M',
    '1500 M',
    '3000 M',
    'Long Jump',
    'High Jump',
    'Shot Put',
    'Discus Throw'
];

const studentsPerPage = 20;

// Loop over sections (e.g. Boys, Girls)
sections.forEach(function(section) {
    const isSubJunior = section.category === 'sub_junior';
    const activeEvents = isSubJunior ? subJuniorEvents : juniorSeniorEvents;
    const sectionStudents = section.students || [];
    const totalPages = Math.max(1, Math.ceil(sectionStudents.length / studentsPerPage));

    for (let page = 0; page < totalPages; page++) {
        const startIndex = page * studentsPerPage;
        const endIndex = Math.min(startIndex + studentsPerPage, sectionStudents.length);
        const pageStudents = sectionStudents.slice(startIndex, endIndex);
        const isFirstPage = page === 0;
        const isLastPage = page === totalPages - 1;
%>

<div class="page-container">

    <!-- Logo Watermark - Centered -->
    <div class="logo-watermark">
        <% if (schoolLogo) { %>
            <img src="<%= schoolLogo %>" alt="Watermark">
        <% } %>
    </div>

    <div class="content-layer">
        <div class="main-content">

            <!-- Header Section -->
            <div class="header-section">
                <% if (schoolLogo) { %>
                <div class="school-logo">
                    <img src="<%= schoolLogo %>" alt="School Logo">
                </div>
                <% } %>
                <div class="school-name"><%= schoolName || 'P.P.M.H.S.S. KOTTUKKARA' %></div>
                <!-- <% if (typeof arabicText !== 'undefined' && arabicText) { %>
                <div class="arabic-text"><%= arabicText %></div>
                <% } %> -->
                <div class="main-title">ANNUAL SPORTS MEET - <%= academicYear %></div>
                <div class="sub-title">ENTRY FORM &mdash; <%= section.categoryTitle.toUpperCase() %> (<%= section.genderTitle.toUpperCase() %>)</div>

                <!-- Info Bar -->
                <div class="info-bar">
                    <span class="info-item"><strong>Class:</strong> <%= className %></span>
                    <span class="info-item"><strong>Category:</strong> <%= section.categoryTitle %></span>
                    <span class="info-item"><strong>Group:</strong> <%= section.genderTitle %></span>
                    <span class="info-item"><strong>House:</strong> <%= houseName || '____________________' %></span>
                    <span class="info-item"><strong>Total In Group:</strong> <%= sectionStudents.length %></span>
                </div>
            </div>

            <!-- Table -->
            <div class="table-wrapper">
                <table class="main-table <%= isSubJunior ? 'table-sub-junior' : 'table-junior-senior' %>" cellspacing="0" cellpadding="0">
                    <thead>
                        <tr>
                            <th class="col-sl">Roll No</th>
                            <th class="col-adm">Adm No</th>
                            <th class="col-name">Name of Student</th>
                            <th class="col-chest">Chest No</th>
                            <% activeEvents.forEach(function(event) { %>
                            <th class="col-event"><%= event %></th>
                            <% }); %>
                            <th class="col-remarks">Remarks</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% 
                        pageStudents.forEach(function(student, index) { 
                        %>
                        <tr>
                            <td class="text-center"><%= student.rollNumber || '-' %></td>
                            <td class="text-center"><%= student.admissionNo || '-' %></td>
                            <td class="text-left student-name"><%= student.name %></td>
                            <td class="text-center">&nbsp;</td>
                            <% activeEvents.forEach(function() { %>
                            <td class="text-center tick-box">&nbsp;</td>
                            <% }); %>
                            <td class="text-center">&nbsp;</td>
                        </tr>
                        <% }); %>

                        <% 
                        // Fill remaining rows up to studentsPerPage so EVERY page has exactly 20 rows and no white space!
                        const blanksNeeded = studentsPerPage - pageStudents.length;
                        for (let b = 0; b < blanksNeeded; b++) {
                            const blankSlNo = startIndex + pageStudents.length + b + 1;
                        %>
                        <tr>
                            <td class="text-center">&nbsp;</td>
                            <td class="text-center">&nbsp;</td>
                            <td class="text-left student-name" style="color: #bbb;">&nbsp;</td>
                            <td class="text-center">&nbsp;</td>
                            <% activeEvents.forEach(function() { %>
                            <td class="text-center tick-box">&nbsp;</td>
                            <% }); %>
                            <td class="text-center">&nbsp;</td>
                        </tr>
                        <% 
                        } 
                        %>
                    </tbody>
                </table>
            </div>

            <!-- Footer Section -->
            <div class="footer-section">
                <div class="page-meta">
                    <span>Generated on: <%= generatedDate || new Date().toLocaleDateString('en-IN') %></span>
                    <span><%= section.categoryTitle %> - <%= section.genderTitle %></span>
                    <span>Page <%= page + 1 %> of <%= totalPages %></span>
                </div>
            </div>

        </div>
    </div>
</div>

<% 
    } // end for pages
}); // end for sections
%>

</body>
</html>
