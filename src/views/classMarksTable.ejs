<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Class Marks - <%= className %></title>
<style>
@page {
    size: A4 landscape;
    margin: 10mm;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: "Times New Roman", serif;
    background: #fff;
    color: #000;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
    font-size: 10px;
}

/* Watermark */
.logo-watermark {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 140mm;
    height: 140mm;
    opacity: 0.04;
    z-index: -1;
    pointer-events: none;
}

.logo-watermark img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

/* Table container to ensure full width */
.table-container {
    width: 100%;
}

/* Header Section inside thead to repeat on every page */
.school-header-cell {
    border: none !important;
    padding: 0 !important;
    text-align: center;
    background: #fff !important;
}

.header-content {
    text-align: center;
    margin-bottom: 10px;
    border-bottom: 2px solid #333;
    padding-bottom: 10px;
}

.school-logo {
    width: 18mm;
    height: 18mm;
    margin: 0 auto 5px;
}

.school-logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
}

.school-name {
    font-size: 16px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 3px;
}

.school-address {
    font-size: 9px;
    margin-bottom: 5px;
    font-weight: bold;
}

.report-title {
    font-size: 12px;
    font-weight: bold;
    text-transform: uppercase;
    margin-top: 5px;
}

.info-grid {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 10px;
    border: 1px solid #000;
    padding: 6px;
    background: #f9f9f9;
}

.info-item {
    display: flex;
    gap: 10px;
}

.info-label {
    font-weight: bold;
}

/* Table */
table {
    width: 100%;
    border-collapse: collapse;
    font-size: 9px;
    page-break-inside: auto;
}

tr {
    page-break-inside: avoid;
    page-break-after: auto;
}

thead {
    display: table-header-group;
}

tfoot {
    display: table-footer-group;
}

th, td {
    border: 1px solid #000;
    padding: 4px;
    text-align: center;
    vertical-align: middle;
}

.col-header {
    background-color: #f0f0f0;
    font-weight: bold;
}

td.text-left {
    text-align: left;
}

.ab {
    color: #d32f2f;
    font-weight: bold;
}
.not-entered {
    color: #9e9e9e;
}
.bold {
    font-weight: bold;
}

/* Footer */
.footer-cell {
    border: none !important;
    text-align: right;
    padding-top: 10px !important;
    font-size: 8px;
    color: #666;
}
</style>
</head>
<body>
    <!-- Watermark -->
    <div class="logo-watermark">
        <% if (schoolLogo) { %>
            <img src="<%= schoolLogo %>" alt="Watermark" />
        <% } %>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <!-- School Header (spans all columns) -->
                <tr>
                    <th class="school-header-cell" colspan="<%= subjects.length + 5 %>">
                        <div class="header-content">
                            <% if (schoolLogo) { %>
                                <div class="school-logo">
                                    <img src="<%= schoolLogo %>" alt="School Logo" />
                                </div>
                            <% } %>
                            <div class="school-name">PPM HIGHER SECONDARY SCHOOL</div>
                            <div class="school-address">KOTTUKKARA, KONDOTTY, MALAPPURAM, KERALA 673638</div>
                            <div class="report-title">CLASS MARKS OVERVIEW</div>
                        </div>

                        <div class="info-grid">
                            <div class="info-item">
                                <span class="info-label">CLASS:</span>
                                <span><%= className %></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">EXAM:</span>
                                <span><%= examName %></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">ACADEMIC YEAR:</span>
                                <span><%= academicYear %></span>
                            </div>
                            <div class="info-item">
                                <span class="info-label">TOTAL STUDENTS:</span>
                                <span><%= totalStudents %></span>
                            </div>
                        </div>
                    </th>
                </tr>
                
                <!-- Table Column Headers -->
                <tr>
                    <th class="col-header" style="width: 3%">Rank</th>
                    <th class="col-header" style="width: 15%">Student</th>
                    <% subjects.forEach(function(subj) { %>
                        <th class="col-header">
                            <div><%= subj.displayName || subj.subjectName %></div>
                            <div style="font-weight: normal; font-size: 8px; margin-top: 2px;">Max: <%= subj.maxMarks || 100 %></div>
                        </th>
                    <% }); %>
                    <th class="col-header" style="width: 6%">Total</th>
                    <th class="col-header" style="width: 5%">%</th>
                    <th class="col-header" style="width: 5%">Grade</th>
                </tr>
            </thead>
            <tbody>
                <% students.forEach(function(student) { %>
                    <tr>
                        <td class="bold"><%= student.rank || '-' %></td>
                        <td class="text-left">
                            <div class="bold"><%= student.name || student.studentName || student.fullName %></div>
                            <% if(student.admissionNo) { %><div style="font-size: 7px; color: #555;"><%= student.admissionNo %></div><% } %>
                        </td>
                        <% subjects.forEach(function(examSubj) { %>
                            <% 
                               // Find the mark for this exact subject in the student's subjects array
                               var sm = student.subjects ? student.subjects.find(function(s) { 
                                   return s.examSubjectId && (s.examSubjectId.toString() === examSubj.examSubjectId.toString()) 
                               }) : null;
                               
                               if (!sm && student.subjectMarks) {
                                   sm = student.subjectMarks.find(function(s) {
                                       return s.examSubjectId && (s.examSubjectId.toString() === examSubj.examSubjectId.toString());
                                   });
                               }
                            %>
                            <td>
                                <% if(sm) { %>
                                    <% if(sm.isAbsent) { %>
                                        <span class="ab">AB</span>
                                    <% } else if(!sm.isEntered) { %>
                                        <span class="not-entered">—</span>
                                    <% } else { %>
                                        <span class="bold"><%= sm.totalScore !== undefined ? sm.totalScore : sm.total %></span>
                                    <% } %>
                                <% } else { %>
                                    <span class="not-entered">—</span>
                                <% } %>
                            </td>
                        <% }); %>
                        <td class="bold" style="background-color: #f9f9f9;"><%= student.totalObtained !== undefined ? student.totalObtained : student.totalMarks %> / <%= student.totalMax !== undefined ? student.totalMax : student.totalMaxMarks %></td>
                        <td class="bold" style="background-color: #f9f9f9;"><%= (student.percentage !== undefined ? student.percentage : 0).toFixed(1) %>%</td>
                        <td class="bold" style="background-color: #f9f9f9;"><%= student.gradeInfo ? student.gradeInfo.grade : student.grade %></td>
                    </tr>
                <% }); %>
            </tbody>
            <tfoot>
                <tr>
                    <td class="footer-cell" colspan="<%= subjects.length + 5 %>">
                        Generated on <%= new Date().toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</body>
</html>
